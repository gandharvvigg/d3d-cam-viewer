<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/zoomLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:use_controller="false"
            app:shutter_background_color="#000000" />

        <ImageView
            android:id="@+id/mjpegView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF" />

    <TextView
        android:id="@+id/recBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="16dp"
        android:background="#99000000"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="● REC SD"
        android:textColor="#FF5252"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="88dp"
        android:background="#AA000000"
        android:gravity="center"
        android:maxWidth="420dp"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Overlay controls (tap the video to show/hide) -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#88000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/OverlayButton"
                android:contentDescription="Cameras"
                android:text="☰" />

            <TextView
                android:id="@+id/camTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordings"
                style="@style/OverlayButton"
                android:contentDescription="Recordings"
                android:text="🎞" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/OverlayButton"
                android:contentDescription="Camera settings"
                android:text="⚙" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#88000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSnap"
                style="@style/OverlayButton"
                android:contentDescription="Take photo"
                android:text="📷" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/OverlayButton"
                android:contentDescription="Mute"
                android:text="🔊" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuality"
                style="@style/OverlayButton"
                android:contentDescription="Stream quality"
                android:text="HD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPtz"
                style="@style/OverlayButton"
                android:contentDescription="Pan and tilt controls"
                android:text="✥" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotate"
                style="@style/OverlayButton"
                android:contentDescription="Rotate"
                android:text="⟳" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPip"
                style="@style/OverlayButton"
                android:contentDescription="Picture in picture"
                android:text="⧉" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReconnect"
                style="@style/OverlayButton"
                android:contentDescription="Reconnect"
                android:text="↻" />
        </LinearLayout>

        <!-- Pan / tilt pad -->
        <LinearLayout
            android:id="@+id/ptzPad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="72dp"
            android:orientation="vertical">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Space android:layout_width="56dp" android:layout_height="56dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnUp" style="@style/PadButton" android:text="▲" android:contentDescription="Tilt up" />
                <Space android:layout_width="56dp" android:layout_height="56dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLeft" style="@style/PadButton" android:text="◀" android:contentDescription="Pan left" />
                <Space android:layout_width="56dp" android:layout_height="56dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRight" style="@style/PadButton" android:text="▶" android:contentDescription="Pan right" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Space android:layout_width="56dp" android:layout_height="56dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDown" style="@style/PadButton" android:text="▼" android:contentDescription="Tilt down" />
                <Space android:layout_width="56dp" android:layout_height="56dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
